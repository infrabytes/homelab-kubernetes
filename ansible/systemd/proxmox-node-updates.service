[Unit]
Description=Rolling Proxmox host maintenance (drain-aware)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deschain
RuntimeDirectory=proxmox-node-updates
# Specifiers resolve against the system manager, so %h is /root here, not deschain's home.
ExecStartPre=/usr/bin/git -C /home/deschain/homelab/homelab-kubernetes pull --ff-only
ExecStart=/home/deschain/homelab/homelab-kubernetes/ansible/run-maintenance.sh
TimeoutStartSec=4h
