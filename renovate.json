{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "prHourlyLimit": 0,
  "ignorePaths": [
    "**/.terragrunt-cache/**",
    "**/artifacts/**"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/^platform\\/.*\\.ya?ml$/",
      "/^apps\\/.*\\.ya?ml$/",
      "/^argocd\\/.*\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^platform\\/.*\\.ya?ml$/",
      "/^apps\\/.*\\.ya?ml$/"
    ]
  },
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Terragrunt CLI version pinned in the pre-commit and tool-cache workflows",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/(pre-commit|warm-tool-cache)\\.ya?ml$/"
      ],
      "matchStrings": [
        "tg_version:\\s*(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "gruntwork-io/terragrunt",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "OpenTofu CLI version pinned in the pre-commit/tool-cache workflows and for the Atlantis projects",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/(pre-commit|warm-tool-cache)\\.ya?ml$/",
        "/^atlantis\\.ya?ml$/"
      ],
      "matchStrings": [
        "tofu_version:\\s*(?<currentValue>[^\\s]+)",
        "terraform_version:\\s*\"?(?<currentValue>[0-9.]+)\"?"
      ],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "TFLint version pinned in the pre-commit and tool-cache workflows",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/(pre-commit|warm-tool-cache)\\.ya?ml$/"
      ],
      "matchStrings": [
        "tflint_version:\\s*(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "terraform-linters/tflint",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Kubeconform version pinned in the pre-commit workflow",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/pre-commit\\.ya?ml$/"
      ],
      "matchStrings": [
        "kubeconform-version:\\s*(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "yannh/kubeconform",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Helm CLI version pinned in the CI workflows",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/(pre-commit|pr-preview|warm-tool-cache)\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\n\\s*version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "kubectl version pinned in the PR preview and tool-cache workflows (matches kubernetes_version in env.hcl)",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/(pr-preview|warm-tool-cache)\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\n\\s*version:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "PyYAML version pinned in the pre-commit workflow",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/pre-commit\\.ya?ml$/"
      ],
      "matchStrings": [
        "pyyaml==(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "pyyaml",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "argocd-diff-preview binary version pinned in the PR preview workflow",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/pr-preview\\.ya?ml$/"
      ],
      "matchStrings": [
        "ARGOCD_DIFF_PREVIEW_VERSION:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "dag-andersen/argocd-diff-preview",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "GitHub CLI version pinned in the PR preview workflow",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/pr-preview\\.ya?ml$/"
      ],
      "matchStrings": [
        "GH_CLI_VERSION:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "cli/cli",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "kind binary version pinned in the PR preview workflow",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/pr-preview\\.ya?ml$/"
      ],
      "matchStrings": [
        "KIND_VERSION:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "vcluster CLI version pinned in the PR preview workflow",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/pr-preview\\.ya?ml$/"
      ],
      "matchStrings": [
        "VCLUSTER_VERSION:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "loft-sh/vcluster",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Argo CD Helm chart version installed in the PR preview vCluster",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/pr-preview\\.ya?ml$/"
      ],
      "matchStrings": [
        "--version\\s+(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "argo-cd",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://argoproj.github.io/argo-helm/",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Talos Linux version",
      "managerFilePatterns": [
        "/^infra\\/env\\.hcl$/"
      ],
      "matchStrings": [
        "talos_version\\s*=\\s*\"(?<currentValue>[^\"\\s]+)\""
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Kubernetes version (latest stable release)",
      "managerFilePatterns": [
        "/^infra\\/env\\.hcl$/"
      ],
      "matchStrings": [
        "kubernetes_version\\s*=\\s*\"(?<currentValue>[^\"\\s]+)\""
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Cilium Helm chart version",
      "managerFilePatterns": [
        "/^infra\\/env\\.hcl$/"
      ],
      "matchStrings": [
        "cilium_chart_version\\s*=\\s*\"(?<currentValue>[^\"\\s]+)\""
      ],
      "depNameTemplate": "cilium",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://helm.cilium.io/"
    },
    {
      "customType": "regex",
      "description": "Gateway API CRD version",
      "managerFilePatterns": [
        "/^infra\\/env\\.hcl$/"
      ],
      "matchStrings": [
        "gateway_api_crds_version\\s*=\\s*\"(?<currentValue>[^\"\\s]+)\""
      ],
      "depNameTemplate": "kubernetes-sigs/gateway-api",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "hubble-observer chart artifact pinned in the flows dashboard CR (docker datasource on the OCI chart; must match the chart Application's targetRevision)",
      "managerFilePatterns": [
        "/^platform\\/observability\\/dashboards\\/flows-dashboard\\.ya?ml$/"
      ],
      "matchStrings": [
        "reference:\\s*ghcr\\.io/onzack/helm-charts/hubble-observer:(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "ghcr.io/onzack/helm-charts/hubble-observer",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Agent Sandbox controller image tag in the chart Application values (docker datasource: only moves when the matching image is promoted)",
      "managerFilePatterns": [
        "/^platform\\/agent-sandbox\\/application\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*\\n\\s*tag:\\s*(?<currentValue>v?[0-9.]+)"
      ],
      "depNameTemplate": "registry.k8s.io/agent-sandbox/agent-sandbox-controller",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "sops binary version pinned in the windrunner setup script",
      "managerFilePatterns": [
        "/^ansible\\/windrunner-setup\\.sh$/"
      ],
      "matchStrings": [
        "SOPS_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "getsops/sops",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Terragrunt binary downloaded by the Atlantis initConfig script (must match tg_version in the CI workflows)",
      "managerFilePatterns": [
        "/^platform\\/atlantis\\/application\\.ya?ml$/"
      ],
      "matchStrings": [
        "terragrunt/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/terragrunt_linux_amd64"
      ],
      "depNameTemplate": "gruntwork-io/terragrunt",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "sops binary downloaded by the Atlantis initConfig script (must match the windrunner setup pin)",
      "managerFilePatterns": [
        "/^platform\\/atlantis\\/application\\.ya?ml$/"
      ],
      "matchStrings": [
        "sops/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/sops-v"
      ],
      "depNameTemplate": "getsops/sops",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "kubectl binary downloaded by the Atlantis initConfig script (must match kubernetes_version in infra/env.hcl)",
      "managerFilePatterns": [
        "/^platform\\/atlantis\\/application\\.ya?ml$/"
      ],
      "matchStrings": [
        "dl\\.k8s\\.io/release/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/bin/linux/amd64/kubectl"
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "k3s version installed by the windrunner k3s playbook (tracks kubernetes_version in infra/env.hcl; a +k3sN rebuild of the same version is a manual edit because semver ignores build metadata)",
      "managerFilePatterns": [
        "/^ansible\\/windrunner-k3s\\.ya?ml$/"
      ],
      "matchStrings": [
        "k3s_version:\\s*\"(?<currentValue>v[0-9.]+\\+k3s[0-9]+)\""
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "grafana-github-datasource plugin version required by the GrafanaDatasource CR (plugin releases match the grafana/github-datasource tags)",
      "managerFilePatterns": [
        "/^platform\\/observability\\/grafana-github-datasource\\.ya?ml$/"
      ],
      "matchStrings": [
        "name:\\s*grafana-github-datasource\\s*\\n\\s*version:\\s*\"?(?<currentValue>\\d+\\.\\d+\\.\\d+)\"?"
      ],
      "depNameTemplate": "grafana/github-datasource",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "pi release installed into both sandboxes; the agent models and flags follow it",
      "managerFilePatterns": [
        "/^platform\\/alert-triage\\/(agent-config|memory-rightsize-agent-config)\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>@earendil-works/pi-coding-agent)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "kubectl downloaded into both sandboxes; must match kubernetes_version in infra/env.hcl",
      "managerFilePatterns": [
        "/^platform\\/alert-triage\\/(sandbox-template|memory-rightsize-sandbox-template)\\.ya?ml$/"
      ],
      "matchStrings": [
        "name:\\s*KUBECTL_VERSION\\s*\\n\\s*value:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Self-hosted Renovate engine version pinned in the renovate workflow; must match the pre-commit renovatebot/pre-commit-hooks rev (same release stream)",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/renovate\\.ya?ml$/"
      ],
      "matchStrings": [
        "RENOVATE_VERSION:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "ghcr.io/renovatebot/renovate",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [
        ".github/**"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "The self-hosted image and the pre-commit validator rev are the same Renovate release stream; bump both in one branch",
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate",
        "renovatebot/pre-commit-hooks"
      ],
      "groupName": "renovate",
      "groupSlug": "renovate"
    },
    {
      "matchFileNames": [
        ".pre-commit-config.yaml"
      ],
      "groupName": "pre-commit hooks",
      "groupSlug": "pre-commit"
    },
    {
      "matchFileNames": [
        "infra/**"
      ],
      "groupName": "Terraform",
      "groupSlug": "terraform"
    },
    {
      "matchFileNames": [
        "platform/**"
      ],
      "groupName": "platform",
      "groupSlug": "platform"
    },
    {
      "matchFileNames": [
        "apps/**"
      ],
      "groupName": "apps",
      "groupSlug": "apps"
    },
    {
      "description": "The Cilium chart is pinned twice (cilium_chart_version in infra/env.hcl and the hubble-ui app); the UI must match the deployed chart, so bump both in one branch.",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "cilium"
      ],
      "groupName": "cilium chart",
      "groupSlug": "cilium-chart"
    },
    {
      "description": "agent-sandbox is a git-sourced chart pinned twice: its targetRevision comes from the argocd manager's git-tags lookup, its image.tag from the regex docker lookup. Neither datasource reports a release timestamp (git-tags has none; docker does only on Docker Hub), so minimumReleaseAgeBehaviour=timestamp-optional let both skip the 3-day gate and git-tags offered the v1.0.8 tag while upstream had no v1.0.8 release. github-releases only offers published releases and carries published_at; the tag's images are promoted before the release is published, so image.tag still names a real image.",
      "matchFileNames": [
        "platform/agent-sandbox/application.yaml"
      ],
      "matchPackageNames": [
        "https://github.com/kubernetes-sigs/agent-sandbox",
        "registry.k8s.io/agent-sandbox/agent-sandbox-controller"
      ],
      "overrideDatasource": "github-releases",
      "overrideDepName": "kubernetes-sigs/agent-sandbox",
      "overridePackageName": "kubernetes-sigs/agent-sandbox"
    },
    {
      "description": "Hold majors for review regardless of changelog content",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Hold the CI Python at 3.14: ansible-core (latest 2.21.5) supports up to 3.14, and the pre-commit ansible-lint hook crashes on 3.15. Lift the cap once ansible-core supports 3.15.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    },
    {
      "description": "Automerge routine updates 3 days after release when the datasource reports a release timestamp: docker outside Docker Hub and git-tags carry none, and the default timestamp-required would hold every branch containing them pending forever.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Atlantis is the sole merger for infra PRs (apply-before-merge)",
      "matchFileNames": [
        "infra/**"
      ],
      "automerge": false
    },
    {
      "description": "CLI versions pinned in several files (CI, the Atlantis initConfig script, the windrunner playbook) must move in one branch",
      "matchDepNames": [
        "gruntwork-io/terragrunt"
      ],
      "groupName": "terragrunt CLI",
      "groupSlug": "terragrunt"
    },
    {
      "description": "CLI versions pinned in several files (CI, the Atlantis initConfig script, the windrunner setup script) must move in one branch",
      "matchDepNames": [
        "getsops/sops"
      ],
      "groupName": "sops CLI",
      "groupSlug": "sops"
    },
    {
      "description": "Every kubectl and kubernetes_version pin must move in one branch so they never disagree",
      "matchDepNames": [
        "kubernetes/kubernetes"
      ],
      "groupName": "kubernetes version",
      "groupSlug": "kubernetes-version"
    },
    {
      "description": "The k3s install must track kubernetes_version in infra/env.hcl",
      "matchDepNames": [
        "k3s-io/k3s"
      ],
      "groupName": "kubernetes version",
      "groupSlug": "kubernetes-version"
    }
  ]
}
