          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{verdict}}"
        }
      ],
      "description": "Hubble flow metric: FORWARDED vs DROPPED. Counts both directions and to-overlay copies, so treat it as a trend, not an exact packet rate."
