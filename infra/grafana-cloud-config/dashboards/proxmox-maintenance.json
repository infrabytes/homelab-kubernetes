{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 173, 0.6)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Rolling PVE host maintenance (ansible/proxmox-node-updates.yml, Sunday 04:00 timer): per-host patch results, reboot decisions and the raw run log from Grafana Cloud Loki (job=proxmox-node-updates). Alert rules for this job live in the same folder.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Failed host steps (7d)",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.2",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(count_over_time({job=\"proxmox-node-updates\"} |= \"result=failed\" [7d]))",
          "queryType": "instant",
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Host steps that failed or aborted the roll in the last 7 days. Any value above 0 means a run did not complete — the failed-run alert fires on these too."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Runs (8d)",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.2",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(count_over_time({job=\"proxmox-node-updates\"} |= \"run=proxmox-node-updates\" [8d]))",
          "queryType": "instant",
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Completed runs in the last 8 days (summary lines only). Zero means the weekly timer has not produced a result — the 8-day dead-man alert fires on the same condition."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Host reboots (7d)",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 10,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.2",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(count_over_time({job=\"proxmox-node-updates\"} |= \"reboot=True\" [7d]))",
          "queryType": "instant",
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Host reboots in the last 7 days. Patch-only runs (no reboot required) do not count."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Log lines per host",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 9,
        "x": 15,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 60,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "12.3.2",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (host) (count_over_time({job=\"proxmox-node-updates\"}[1h]))",
          "queryType": "range",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "{{host}}"
        }
      ],
      "description": "Reporting activity per host over time. A host with no lines for more than a week has not reported — check the timer and the dead-man alert."
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Run log (job=proxmox-node-updates)",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 17,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "sortOrder": "Descending",
        "wrapLines": true,
        "showLabels": true,
        "showTime": true,
        "enableLogDetails": true
      },
      "pluginVersion": "12.3.2",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "{job=\"proxmox-node-updates\", host=~\"$host\"}",
          "queryType": "range",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "description": "Raw run log. Lines are k=v: host, result (success/failed), upgrades_applied, reboot + reboot_reason, drained; the summary line (host=summary) carries run=proxmox-node-updates with hosts_rolled and reboots counts."
    }
  ],
  "preload": false,
  "refresh": "5m",
  "schemaVersion": 42,
  "tags": [
    "proxmox",
    "maintenance",
    "patching"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "Loki",
          "value": "${DS_LOKI}"
        },
        "includeAll": false,
        "label": "Datasource",
        "name": "datasource",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "definition": "label_values({job=\"proxmox-node-updates\"}, host)",
        "includeAll": true,
        "label": "Host",
        "multi": true,
        "name": "host",
        "options": [],
        "query": {
          "label": "host",
          "stream": "{job=\"proxmox-node-updates\"}",
          "type": "label_values"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "PVE Host Maintenance",
  "uid": "homelab-proxmox-maintenance",
  "version": 1,
  "weekStart": ""
}
